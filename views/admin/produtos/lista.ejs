<%- include('../partials/header') %>
<%- include('../partials/menu') %>

<main class="container py-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0">
                    <i class="bi bi-box-seam"></i>
                    Produtos
                </h4>
                <a href="/admin/produtos/form-cadastrar" class="btn btn-light btn-sm">
                    <i class="bi bi-plus-circle"></i>
                    Novo produto
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Produto</th>
                            <th>Marca</th>
                            <th>Categoria</th>
                            <th>Tipo</th>
                            <th>Valor</th>
                            <th>Estoque</th>
                            <th>Imagem</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (produtos && produtos.length > 0) { %>
                            <% produtos.forEach(produto => { %>
                                <tr>
                                    <td><%= produto.id %></td>
                                    <td><%= produto.nome %></td>
                                    <td><%= produto.marca || '-' %></td>
                                    <td><%= produto.categoria || '-' %></td>
                                    <td><%= produto.tipo || '-' %></td>
                                    <td>R$ <%= Number(produto.valor).toFixed(2).replace('.', ',') %></td>
                                    <td><%= produto.estoque %></td>
                                    <td>
                                        <img src="/uploads/<%= produto.imagem %>" alt="<%= produto.nome %>" style="width: 45px; height: 45px; object-fit: contain;" onerror="this.src='https://via.placeholder.com/45'">
                                    </td>
                                    <td>
                                        <a href="/admin/produtos/editar/<%= produto.id %>" class="btn btn-warning btn-sm">
                                            <i class="bi bi-pencil"></i> Editar
                                        </a>
                                        <a href="/admin/produtos/excluir/<%= produto.id %>" class="btn btn-danger btn-sm" onclick="return confirm('Deseja realmente excluir este produto?')">
                                            <i class="bi bi-trash"></i> Excluir
                                        </a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="9" class="text-center py-3 text-muted">Nenhum produto cadastrado no banco de dados.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>