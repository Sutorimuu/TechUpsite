<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TechUp - Esqueci a Senha</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Iceland&family=Kodchasan:wght@300;400;500;600;700&family=Ubuntu:wght@300;400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .auth-container {
      position: relative;
      width: 100vw;
      height: 100vh;
      background-color: var(--color-primary-dark);
      overflow: hidden;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .auth-bg-image {
      position: absolute;
      inset: 0;
      background-image: url('/imagens/f5.png');
      background-size: cover;
      background-position: center;
      z-index: 1;
      opacity: 0.85;
    }
    .auth-content {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .auth-logo {
      font-family: var(--font-logo);
      font-size: 70px;
      color: var(--color-white);
      line-height: 1;
    }
    .auth-subtitle {
      font-family: var(--font-body);
      font-size: 14px;
      color: var(--color-white);
      margin-bottom: 20px;
    }
    .auth-title {
      font-family: var(--font-heading);
      font-size: 28px;
      color: var(--color-white);
      margin-bottom: 18px;
      font-weight: 400;
    }
    .auth-form {
      display: flex;
      flex-direction: column;
      gap: 12px;
      width: 340px;
      margin-bottom: 12px;
    }
    .auth-input {
      width: 100%;
      padding: 12px 18px;
      border-radius: 6px;
      border: none;
      outline: none;
      font-size: 14px;
      font-family: var(--font-body);
      background-color: var(--color-white);
      color: #333;
    }
    .auth-btn {
      background-color: var(--color-primary-dark);
      color: var(--color-white);
      border: 1px solid var(--color-primary-light);
      width: 340px;
      padding: 12px;
      font-size: 22px;
      font-family: var(--font-heading);
      border-radius: 6px;
      cursor: pointer;
      margin-bottom: 12px;
      transition: background-color 0.2s;
      text-decoration: none;
      display: block;
      text-align: center;
    }
    .auth-btn:hover {
      background-color: var(--color-primary-med);
    }
    .auth-link {
      color: #83ADA8;
      text-decoration: none;
      font-family: var(--font-body);
      font-size: 14px;
      margin-bottom: 4px;
    }
    .auth-link:hover {
      color: var(--color-white);
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <div class="auth-container">
    <div class="auth-bg-image"></div>
    <div class="auth-content">
      <div class="auth-logo">TechUp</div>
      <div class="auth-subtitle">Seus eletrônicos em Alta!</div>

      <div class="auth-title">Esqueci a senha</div>

      <div class="auth-form">
        <input type="email" name="email" placeholder="E-mail" class="auth-input" required>
        <input type="date" name="nascimento" placeholder="Data de Nascimento" class="auth-input" required>
      </div>

      <a href="/nova-senha" class="auth-btn">Próximo Passo</a>

      <a href="/auth" class="auth-link">Voltar</a>
    </div>
  </div>
</body>
</html>