<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TechUp - Acesso</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Iceland&family=Kodchasan:wght@300;400;500;600;700&family=Ubuntu:wght@300;400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .auth-container {
      position: relative;
      width: 100vw;
      height: 100vh;
      background-color: var(--color-primary-dark);
      overflow: hidden;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .auth-bg-image {
      position: absolute;
      inset: 0;
      background-image: url('/imagens/f1.png');
      background-size: cover;
      background-position: center;
      z-index: 1;
      opacity: 0.85;
    }
    .auth-content {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .auth-logo {
      font-family: var(--font-logo);
      font-size: 80px;
      color: var(--color-white);
      line-height: 1;
    }
    .auth-subtitle {
      font-family: var(--font-body);
      font-size: 16px;
      color: var(--color-white);
      margin-bottom: 50px;
    }
    .auth-btn-dark {
      background-color: var(--color-card-bg);
      color: var(--color-white);
      border: none;
      width: 320px;
      padding: 14px;
      font-size: 24px;
      font-family: var(--font-heading);
      border-radius: 6px;
      cursor: pointer;
      margin-bottom: 16px;
      text-decoration: none;
      display: inline-block;
      transition: opacity 0.2s;
    }
    .auth-btn-green {
      background-color: var(--color-primary-dark);
      color: var(--color-white);
      border: 1px solid var(--color-primary-light);
      width: 320px;
      padding: 14px;
      font-size: 24px;
      font-family: var(--font-heading);
      border-radius: 6px;
      cursor: pointer;
      margin-bottom: 24px;
      text-decoration: none;
      display: inline-block;
      transition: background-color 0.2s;
    }
    .auth-btn-green:hover {
      background-color: var(--color-primary-med);
    }
    .auth-link {
      color: #83ADA8;
      text-decoration: none;
      font-family: var(--font-body);
      font-size: 15px;
      margin-bottom: 8px;
    }
    .auth-link:hover {
      color: var(--color-white);
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <div class="auth-container">
    <div class="auth-bg-image"></div>
    <div class="auth-content">
      <div class="auth-logo">TechUp</div>
      <div class="auth-subtitle">Seus eletrônicos em Alta!</div>

      <a href="/login" class="auth-btn-dark">Login</a>
      <a href="/registro-etapa1" class="auth-btn-green">Registrar</a>
      
      <a href="/esqueci-senha" class="auth-link">Esqueci minha senha</a>
      <a href="/" class="auth-link">Voltar</a>
    </div>
  </div>
</body>
</html>