<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TechUp - Seus eletrônicos em Alta!</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Iceland&family=Kodchasan:wght@300;400;500;600;700&family=Ubuntu:wght@300;400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <% 
    const lista = (typeof produtos !== 'undefined' && produtos.length > 0) ? produtos : mockProdutos;
    
    const ofertas = lista.slice(0, 3);

    const categoriasExistentes = [...new Set(lista.map(p => p.categoria || 'Geral'))];
    const categoriasEmbaralhadas = categoriasExistentes.sort(() => 0.5 - Math.random());
    const secoesSorteadas = categoriasEmbaralhadas.slice(0, 2);
  %>

  <header class="hero-header">
    <div class="carousel-container">
      <div class="carousel-slide active" style="background-image: url('/imagens/1.png');"></div>
      <div class="carousel-slide" style="background-image: url('/imagens/2.png');"></div>
      <div class="carousel-slide" style="background-image: url('/imagens/3.png');"></div>
    </div>

    <img src="/imagens/canto.png" alt="Canto Verde" class="canto-overlay">

    <div class="hero-content">
      <nav class="navbar">
        <div class="logo">TechUp</div>
        <ul class="nav-links">
          <li><a href="produtos">Produtos</a></li>
          <li><a href="#categorias">Categorias</a></li>
          <li><a href="#suporte">Suporte</a></li>
          <li><a href="/admin" class="btn-login">Login</a></li>
        </ul>
      </nav>

      <div class="banner-text">
        <h1>Seus eletrônicos<br>em Alta!</h1>
        <div class="search-box">
          <input type="text" placeholder="Pesquisar por celulares, perifericos, etc">
        </div>
      </div>

      <div class="carousel-controls">
        <button class="arrow" id="prevBtn">&larr;</button>
        <div class="dots">
          <span class="dot active"></span>
          <span class="dot"></span>
          <span class="dot"></span>
        </div>
        <button class="arrow" id="nextBtn">&rarr;</button>
      </div>
    </div>
  </header>

  <main class="main-container" id="produtos">

    <section class="category-section">
      <h2 class="section-title">
        <span>Ofertas</span>
        <div class="title-line"></div>
      </h2>

      <div class="products-grid">
        <% ofertas.forEach(prod => { %>
          <a href="/produto/<%= prod.id %>" class="product-card-link">
            <div class="product-card">
              <div class="card-img-wrapper">
                <span class="categoria-badge"><%= prod.tipo || prod.categoria || 'Oferta' %></span>
                <img src="/uploads/<%= prod.imagem %>" alt="<%= prod.nome %>" onerror="this.src='https://via.placeholder.com/260x160/ffffff/333333?text=TechUp'">
              </div>

              <div class="card-body">
                <div class="brand-title">
                  <span class="brand"><%= prod.marca %></span>
                  <span class="model"><%= prod.nome %></span>
                </div>

                <div class="specs-tags">
                  <% if (prod.tipo) { %><span class="tag"><%= prod.tipo %></span><% } %>
                  <% if (prod.estoque) { %><span class="tag"><%= prod.estoque %></span><% } %>
                </div>

                <div class="price-info">
                  <span class="installment">12x S/Juros: R$ <%= (prod.valor / 10).toFixed(2).replace('.', ',') %></span>
                  <div class="cash-price">
                    A vista: <span class="price-value">R$ <%= Number(prod.valor).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></span>
                  </div>
                </div>
              </div>
            </div>
          </a>
        <% }); %>
      </div>
    </section>

    <% secoesSorteadas.forEach(secaoNome => { %>
      <section class="category-section">
        <h2 class="section-title">
          <span><%= secaoNome %></span>
          <div class="title-line"></div>
        </h2>

        <div class="products-grid">
          <% 
            const prodsDaSecao = lista.filter(p => (p.categoria || 'Geral') === secaoNome).slice(0, 3);
            prodsDaSecao.forEach(prod => { 
          %>
            <a href="/produto/<%= prod.id %>" class="product-card-link">
              <div class="product-card">
                <div class="card-img-wrapper">
                  <span class="categoria-badge"><%= prod.categoria || secaoNome %></span>
                  <img src="/uploads/<%= prod.imagem %>" alt="<%= prod.nome %>" onerror="this.src='https://via.placeholder.com/260x160/ffffff/333333?text=TechUp'">
                </div>

                <div class="card-body">
                  <div class="brand-title">
                    <span class="brand"><%= prod.marca %></span>
                    <span class="model"><%= prod.nome %></span>
                  </div>

                  <div class="specs-tags">
                    <% if (prod.tipo) { %><span class="tag"><%= prod.tipo %></span><% } %>
                    <% if (prod.estoque) { %><span class="tag"><%= prod.estoque %></span><% } %>
                  </div>

                  <div class="price-info">
                    <span class="installment">12x S/Juros: R$ <%= (prod.valor / 10).toFixed(2).replace('.', ',') %></span>
                    <div class="cash-price">
                      A vista: <span class="price-value">R$ <%= Number(prod.valor).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></span>
                    </div>
                  </div>
                </div>
              </div>
            </a>
          <% }); %>
        </div>
      </section>
    <% }); %>

    <div class="see-more-container">
      <button class="btn-see-more">Ver mais produtos</button>
    </div>
  </main>

  <footer class="site-footer">
    <div class="footer-top">
      <div class="footer-col" id="categorias">
        <h3>Departamentos</h3>
        <ul>
          <li><a href="#">Teclados & Mouses</a></li>
          <li><a href="#">Computadores</a></li>
          <li><a href="#">Smartphones</a></li>
          <li><a href="#">Laptops</a></li>
          <li><a href="#">Controles</a></li>
          <li><a href="#">Carregadores</a></li>
          <li><a href="#">Powerbanks</a></li>
          <li><a href="#">Monitor</a></li>
          <li><a href="#">Internet & Wifi</a></li>
          <li><a href="#">Armazenamento</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3>Institucional</h3>
        <ul>
          <li><a href="#">Quem Somos</a></li>
          <li><a href="#">Localização</a></li>
          <li><a href="#">Nossas Lojas</a></li>
        </ul>
      </div>

      <div class="footer-col" id="suporte">
        <h3>Ajuda</h3>
        <ul>
          <li><a href="#">Entrega</a></li>
          <li><a href="#">Garantia</a></li>
          <li><a href="#">Como Comprar</a></li>
          <li><a href="#">Pagamentos</a></li>
          <li><a href="#">SAC</a></li>
          <li><a href="#">Fale Conosco</a></li>
          <li><a href="#">Termos de Privacidade</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3>Social</h3>
        <ul>
          <li><a href="#">Facebook</a></li>
          <li><a href="#">X</a></li>
          <li><a href="#">Instagram</a></li>
          <li><a href="#">LinkedIn</a></li>
          <li><a href="#">Discord</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>2026 TechUp - Todos os direitos não reservados</p>
    </div>
  </footer>

  <script>
    const slides = document.querySelectorAll('.carousel-slide');
    const dots = document.querySelectorAll('.dot');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    let currentIdx = 0;

    function goToSlide(index) {
      slides.forEach((slide, i) => slide.classList.toggle('active', i === index));
      dots.forEach((dot, i) => dot.classList.toggle('active', i === index));
      currentIdx = index;
    }

    function nextSlide() {
      goToSlide((currentIdx + 1) % slides.length);
    }

    function prevSlide() {
      goToSlide((currentIdx - 1 + slides.length) % slides.length);
    }

    nextBtn.addEventListener('click', nextSlide);
    prevBtn.addEventListener('click', prevSlide);
    dots.forEach((dot, index) => dot.addEventListener('click', () => goToSlide(index)));

    setInterval(nextSlide, 4000);
  </script>
</body>
</html>